# Copy this file to .env and fill in your values:
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env (Windows)

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/360group

# MongoDB Atlas (replace user, password, and cluster host)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/360group?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
PORT=3000

# Optional — homepage event cards (https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=

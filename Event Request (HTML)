<!DOCTYPE html>
<html>
<head>
  <title>Event Request</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="container">
    <h1>Request an Event</h1>

    <form id="eventForm">
      <input type="text" id="eventName" placeholder="Event name" required>
      <input type="date" id="eventDate" required>
      <input type="time" id="eventTime" required>
      <input type="text" id="eventLocation" placeholder="Location" required>

      <button type="submit">Send Event Request</button>
    </form>

    <div id="eventCard" class="hidden">
      <h2 id="displayName"></h2>
      <p><strong>Date:</strong> <span id="displayDate"></span></p>
      <p><strong>Time:</strong> <span id="displayTime"></span></p>
      <p><strong>Location:</strong> <span id="displayLocation"></span></p>

      <button id="acceptBtn">Accept</button>
      <button id="denyBtn">Deny</button>

      <p id="responseMessage"></p>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>

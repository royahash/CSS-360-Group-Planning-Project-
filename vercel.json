{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/js/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/css/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/auth/(.*)", "dest": "/server.js" },
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/js/(.*)", "dest": "/src/js/$1" },
    { "src": "/css/(.*)", "dest": "/src/css/$1" },
    { "src": "/html/(.*)", "dest": "/server.js" },
    { "src": "/", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}